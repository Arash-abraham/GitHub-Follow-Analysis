{
  "manifest_version": 3,
  "name": "GitHub Follow Analysis",
  "short_name": "Follow Analysis",
  "version": "1.0.0",
  "description": "Analyze GitHub followers and following, discover one-way connections, filter and sort profiles, and bulk follow or unfollow.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GitHub Follow Analysis",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "css": [
        "content/content.css"
      ],
      "js": [
        "shared/analyzer-ui.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
